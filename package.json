{
  "name": "@numbercutter/sieve",
  "version": "0.2.0",
  "description": "Cheap deterministic checks, an optional local model and an OpenAI-compatible proxy, before paid model calls.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "sieve": "src/cli.ts"
  },
  "exports": "./src/index.ts",
  "files": [
    "src",
    "assets",
    "sieve.config.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "example": "bun src/cli.ts run examples/prompts.jsonl --mock",
    "proxy": "bun examples/proxy.ts",
    "report": "bun src/cli.ts report examples/decisions.jsonl"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/numbercutter/sieve"
  }
}
